<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY"
        android:src="@drawable/widget_glass" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/w_open" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp">
        <TextView android:id="@+id/w_where" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="STUDIO PC"
            android:textColor="#80FFFFFF" android:textSize="10sp" android:letterSpacing="0.06" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="horizontal">
            <FrameLayout android:layout_width="76dp" android:layout_height="76dp">
                <ProgressBar android:id="@+id/w_cpu_ring" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:indeterminate="false" android:max="100" android:progress="34" android:progressDrawable="@drawable/widget_ring_cpu" />
                <TextView android:id="@+id/w_cpu" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="34%"
                    android:textColor="#FFFFFFFF" android:textSize="18sp" android:fontFamily="sans-serif-light" android:maxLines="1" />
            </FrameLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CPU"
                    android:textColor="#B3FFFFFF" android:textSize="10.5sp" android:maxLines="1" />
                <TextView android:id="@+id/w_cpu_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="62°C"
                    android:textColor="#FFFFFFFF" android:textSize="22sp" android:fontFamily="sans-serif-light" android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="horizontal">
            <FrameLayout android:layout_width="76dp" android:layout_height="76dp">
                <ProgressBar android:id="@+id/w_gpu_ring" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:indeterminate="false" android:max="100" android:progress="12" android:progressDrawable="@drawable/widget_ring_gpu" />
                <TextView android:id="@+id/w_gpu" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="12%"
                    android:textColor="#FFFFFFFF" android:textSize="18sp" android:fontFamily="sans-serif-light" android:maxLines="1" />
            </FrameLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GPU"
                    android:textColor="#B3FFFFFF" android:textSize="10.5sp" android:maxLines="1" />
                <TextView android:id="@+id/w_gpu_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="48°C"
                    android:textColor="#FFFFFFFF" android:textSize="22sp" android:fontFamily="sans-serif-light" android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
