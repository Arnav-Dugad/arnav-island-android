<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY"
        android:src="@drawable/widget_glass" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="18dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/w_where" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="6dp" android:gravity="center_vertical"
                android:text="STUDIO PC" android:textColor="#80FFFFFF" android:textSize="10sp" android:letterSpacing="0.06" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:orientation="horizontal">
            <ImageView android:id="@+id/w_wifi" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp"
                android:background="@drawable/widget_tile_on_blue" android:src="@drawable/ic_w_wifi" android:scaleType="center" android:contentDescription="Wi-Fi" />
            <ImageView android:id="@+id/w_bt" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp"
                android:background="@drawable/widget_tile_on_blue" android:src="@drawable/ic_w_bluetooth" android:scaleType="center" android:contentDescription="Bluetooth" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:orientation="horizontal">
            <ImageView android:id="@+id/w_dark" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp"
                android:background="@drawable/widget_tile_off" android:src="@drawable/ic_w_dark" android:scaleType="center" android:contentDescription="Dark mode" />
            <ImageView android:id="@+id/w_mute" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp"
                android:background="@drawable/widget_tile_off" android:src="@drawable/ic_w_volume_off" android:scaleType="center" android:contentDescription="Mute" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
