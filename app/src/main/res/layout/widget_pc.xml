<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_glass" android:orientation="vertical" android:padding="14dp">
    <LinearLayout android:id="@+id/w_open" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/w_cover" android:layout_width="54dp" android:layout_height="54dp" android:scaleType="centerCrop"
            android:src="@drawable/widget_cover_empty" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/w_where" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ARNAV ISLAND"
                android:textColor="#80FFFFFF" android:textSize="10sp" android:letterSpacing="0.06" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
            <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nothing playing"
                android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your PC’s music, here"
                android:textColor="#B3FFFFFF" android:textSize="12.5sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <ImageButton android:id="@+id/w_prev" android:layout_width="38dp" android:layout_height="38dp" android:layout_marginStart="6dp"
            android:background="@drawable/widget_button" android:src="@drawable/ic_w_prev" android:scaleType="center" android:contentDescription="Previous" />
        <ImageButton android:id="@+id/w_play" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="6dp"
            android:background="@drawable/widget_button_play" android:src="@drawable/ic_w_play_dark" android:scaleType="center" android:contentDescription="Play" />
        <ImageButton android:id="@+id/w_next" android:layout_width="38dp" android:layout_height="38dp" android:layout_marginStart="6dp"
            android:background="@drawable/widget_button" android:src="@drawable/ic_w_next" android:scaleType="center" android:contentDescription="Next" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="10dp" android:orientation="horizontal">
        <ImageButton android:id="@+id/w_lock" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/widget_pill"
            android:src="@drawable/ic_w_lock" android:scaleType="center" android:contentDescription="Lock" />
        <ImageButton android:id="@+id/w_ring" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/widget_pill"
            android:src="@drawable/ic_w_ring" android:scaleType="center" android:contentDescription="Ring" />
        <ImageButton android:id="@+id/w_send" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/widget_pill"
            android:src="@drawable/ic_w_send" android:scaleType="center" android:contentDescription="Send" />
        <ImageButton android:id="@+id/w_camera" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/widget_pill"
            android:src="@drawable/ic_w_camera" android:scaleType="center" android:contentDescription="Camera" />
        <ImageButton android:id="@+id/w_paste" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/widget_pill"
            android:src="@drawable/ic_w_paste" android:scaleType="center" android:contentDescription="Paste" />
    </LinearLayout>
</LinearLayout>
