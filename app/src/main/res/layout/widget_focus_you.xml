<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY"
        android:src="@drawable/widget_you" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/w_open" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal"
        android:gravity="center_vertical" android:padding="14dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/w_where" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="FOCUS"
                android:textColor="@color/widget_you_accent" android:textSize="10sp" android:letterSpacing="0.06" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
            <Chronometer android:id="@+id/w_clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"
                android:textColor="@color/widget_you_text" android:textSize="34sp" android:fontFamily="sans-serif-light" android:maxLines="1" />
            <TextView android:id="@+id/w_still" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="25:00"
                android:textColor="@color/widget_you_text" android:textSize="34sp" android:fontFamily="sans-serif-light" android:maxLines="1" />
            <TextView android:id="@+id/w_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Start one on your PC or here"
                android:textColor="@color/widget_you_muted" android:textSize="11.5sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <ImageButton android:id="@+id/w_toggle" android:layout_width="46dp" android:layout_height="46dp" android:layout_marginStart="8dp"
            android:background="@drawable/widget_you_play" android:src="@drawable/ic_w_play_dark" android:scaleType="center" android:contentDescription="Start" android:tint="@color/widget_you_on_play" />
        <TextView android:id="@+id/w_start" android:layout_width="wrap_content" android:layout_height="38dp" android:layout_marginStart="8dp"
            android:background="@drawable/widget_you_pill" android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="25 min"
            android:textColor="@color/widget_you_text" android:textSize="12sp" android:maxLines="1" />
    </LinearLayout>
</FrameLayout>
