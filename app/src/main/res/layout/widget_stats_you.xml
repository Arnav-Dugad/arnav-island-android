<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY"
        android:src="@drawable/widget_you" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/w_open" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/w_where" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="YOUR PC"
                android:textColor="@color/widget_you_accent" android:textSize="10sp" android:letterSpacing="0.06" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
            <TextView android:id="@+id/w_net" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=""
                android:textColor="@color/widget_you_muted" android:textSize="10.5sp" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <FrameLayout android:layout_width="84dp" android:layout_height="84dp">
                <ProgressBar android:id="@+id/w_cpu_ring" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:indeterminate="false" android:max="100" android:progress="0" android:progressDrawable="@drawable/widget_you_ring_cpu" />
                <TextView android:id="@+id/w_cpu" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="—"
                    android:textColor="@color/widget_you_text" android:textSize="19sp" android:fontFamily="sans-serif-light" android:maxLines="1" />
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="CPU"
                android:textColor="@color/widget_you_muted" android:textSize="10.5sp" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <FrameLayout android:layout_width="84dp" android:layout_height="84dp">
                <ProgressBar android:id="@+id/w_gpu_ring" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:indeterminate="false" android:max="100" android:progress="0" android:progressDrawable="@drawable/widget_you_ring_gpu" />
                <TextView android:id="@+id/w_gpu" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="—"
                    android:textColor="@color/widget_you_text" android:textSize="19sp" android:fontFamily="sans-serif-light" android:maxLines="1" />
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="GPU"
                android:textColor="@color/widget_you_muted" android:textSize="10.5sp" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <FrameLayout android:layout_width="84dp" android:layout_height="84dp">
                <ProgressBar android:id="@+id/w_ram_ring" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:indeterminate="false" android:max="100" android:progress="0" android:progressDrawable="@drawable/widget_you_ring_ram" />
                <TextView android:id="@+id/w_ram" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="—"
                    android:textColor="@color/widget_you_text" android:textSize="19sp" android:fontFamily="sans-serif-light" android:maxLines="1" />
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Memory"
                android:textColor="@color/widget_you_muted" android:textSize="10.5sp" android:maxLines="1" />
        </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
