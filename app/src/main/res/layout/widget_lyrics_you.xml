<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY"
        android:src="@drawable/widget_you" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/w_open" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="14dp" android:paddingBottom="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_w_lyrics" android:tint="@color/widget_you_accent" android:importantForAccessibility="no" />
            <TextView android:id="@+id/w_where" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:text="LYRICS"
                android:textColor="@color/widget_you_accent" android:textSize="10sp" android:letterSpacing="0.06" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/w_line" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp"
            android:gravity="center_vertical|start" android:text="Every light in the city is ours tonight" android:textColor="@color/widget_you_text" android:fontFamily="sans-serif-medium"
            android:maxLines="3" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="22sp" android:autoSizeStepGranularity="1sp" />
        <TextView android:id="@+id/w_next" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="And the morning can wait"
            android:textColor="@color/widget_you_dim" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_song" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Night Drive  ·  The Island"
            android:textColor="@color/widget_you_muted" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</FrameLayout>
